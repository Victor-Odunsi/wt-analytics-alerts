# Local dev auth for BigQuery — path to a service-account JSON key with READER
# access to wt-bigquery.client_betika_marts (wt-analyst-chat-betika@... already
# has this at the dataset level; reuse it or grant your own key equivalent access).
GOOGLE_APPLICATION_CREDENTIALS=

# Bot User OAuth Token (xoxb-...) for the Slack app posting these alerts. Needs the
# chat:write scope.
SLACK_BOT_TOKEN=

# Every alert DMs all of these that are set (see DM_RECIPIENT_ENV_VARS in
# alerts/slack_notifier.py) — add a NAME_SLACK_DM_USER_ID entry there for anyone
# else who should get every alert. Find a user ID via their Slack profile's
# "More" > "Copy member ID" (e.g. U0123456789).
DEV_SLACK_DM_USER_ID=
NICK_SLACK_DM_USER_ID=

# Groq API key, used to have an LLM (see DEFAULT_MODEL in alerts/llm_insights.py)
# phrase detected anomalies as a short narrative for the Slack alert. Optional: if
# unset, alerts still go out with just the raw stats.
GROQ_API_KEY=
